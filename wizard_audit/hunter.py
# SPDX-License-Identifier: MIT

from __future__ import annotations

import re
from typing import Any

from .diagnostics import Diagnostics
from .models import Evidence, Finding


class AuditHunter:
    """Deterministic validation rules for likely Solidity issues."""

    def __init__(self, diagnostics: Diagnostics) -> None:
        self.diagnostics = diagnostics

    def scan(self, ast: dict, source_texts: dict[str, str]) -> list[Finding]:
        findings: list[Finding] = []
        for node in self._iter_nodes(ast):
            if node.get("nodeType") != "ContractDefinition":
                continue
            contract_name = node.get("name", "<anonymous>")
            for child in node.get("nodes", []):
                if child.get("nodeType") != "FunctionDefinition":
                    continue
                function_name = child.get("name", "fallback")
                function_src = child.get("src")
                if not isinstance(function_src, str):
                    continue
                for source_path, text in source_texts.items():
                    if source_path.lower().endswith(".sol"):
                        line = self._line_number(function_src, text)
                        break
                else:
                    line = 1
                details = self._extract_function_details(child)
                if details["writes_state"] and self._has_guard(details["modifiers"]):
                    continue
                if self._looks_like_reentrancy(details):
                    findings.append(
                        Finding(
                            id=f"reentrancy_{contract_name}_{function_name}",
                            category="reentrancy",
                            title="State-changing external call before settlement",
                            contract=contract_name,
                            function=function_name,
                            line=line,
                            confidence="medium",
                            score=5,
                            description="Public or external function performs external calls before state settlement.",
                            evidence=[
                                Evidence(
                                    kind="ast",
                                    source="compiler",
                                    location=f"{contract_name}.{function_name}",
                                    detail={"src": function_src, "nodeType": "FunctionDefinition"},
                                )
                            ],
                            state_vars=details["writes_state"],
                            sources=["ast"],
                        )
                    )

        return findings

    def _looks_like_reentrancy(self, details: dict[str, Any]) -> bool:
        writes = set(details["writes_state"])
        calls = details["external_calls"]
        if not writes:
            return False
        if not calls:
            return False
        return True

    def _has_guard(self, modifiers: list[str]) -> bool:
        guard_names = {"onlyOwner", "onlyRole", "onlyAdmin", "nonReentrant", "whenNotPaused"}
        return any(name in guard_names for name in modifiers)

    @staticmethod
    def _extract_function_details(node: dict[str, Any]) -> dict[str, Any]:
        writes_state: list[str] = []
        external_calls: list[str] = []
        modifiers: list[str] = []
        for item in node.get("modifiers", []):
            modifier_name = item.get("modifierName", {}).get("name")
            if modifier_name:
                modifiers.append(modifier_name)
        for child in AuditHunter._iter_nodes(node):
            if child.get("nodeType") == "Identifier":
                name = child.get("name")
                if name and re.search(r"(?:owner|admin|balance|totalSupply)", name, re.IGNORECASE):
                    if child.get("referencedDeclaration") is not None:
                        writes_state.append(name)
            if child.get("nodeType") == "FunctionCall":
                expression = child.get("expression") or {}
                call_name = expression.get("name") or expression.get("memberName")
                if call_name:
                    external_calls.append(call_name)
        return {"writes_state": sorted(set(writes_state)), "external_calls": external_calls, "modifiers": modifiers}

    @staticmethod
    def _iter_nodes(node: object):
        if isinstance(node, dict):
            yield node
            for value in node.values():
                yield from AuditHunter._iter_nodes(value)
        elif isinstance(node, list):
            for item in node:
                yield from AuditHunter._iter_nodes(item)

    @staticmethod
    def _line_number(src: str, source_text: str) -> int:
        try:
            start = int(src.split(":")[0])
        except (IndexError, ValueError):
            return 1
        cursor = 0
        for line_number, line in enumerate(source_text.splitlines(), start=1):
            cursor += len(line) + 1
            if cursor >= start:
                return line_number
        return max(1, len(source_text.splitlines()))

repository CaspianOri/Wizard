from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import tempfile
from pathlib import Path

from .diagnostics import Diagnostics
from .validation import validate_file_path, validate_solc_version


class ToolRunner:
    """Safe, bounded subprocess execution for compilers and external tools."""

    def __init__(self, diagnostics: Diagnostics, *, sandbox: bool = True) -> None:
        self.diagnostics = diagnostics
        self.sandbox = sandbox

    def run(
        self,
        cmd: list[str],
        *,
        timeout: int = 300,
        cwd: Path | None = None,
        env: dict[str, str] | None = None,
        expect_json: bool = False,
        allow_empty: bool = False,
    ) -> tuple[int, str, str]:
        safe_env = {key: value for key, value in os.environ.items() if key in {"PATH", "HOME", "USER", "TMPDIR"}}
        if env:
            safe_env.update(env)

        try:
            completed = subprocess.run(
                cmd,
                cwd=str(cwd) if cwd is not None else None,
                env=safe_env,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
        except FileNotFoundError as exc:
            message = f"Command not found: {cmd[0]}"
            self.diagnostics.add("error", "tool_runner", message, command=cmd, timeout=timeout)
            raise RuntimeError(message) from exc
        except subprocess.TimeoutExpired as exc:
            message = f"Tool timed out after {timeout}s: {' '.join(cmd)}"
            self.diagnostics.add("error", "tool_runner", message, command=cmd, timeout=timeout)
            raise RuntimeError(message) from exc

        stdout = completed.stdout or ""
        stderr = completed.stderr or ""

        if completed.returncode != 0 and not stdout and not allow_empty:
            message = f"Tool exited with rc={completed.returncode}: {' '.join(cmd)}"
            self.diagnostics.add("error", "tool_runner", message, command=cmd, stderr=stderr[:2000])
            raise RuntimeError(message)

        if expect_json and stdout.strip():
            try:
                json.loads(stdout)
            except json.JSONDecodeError as exc:
                message = f"Tool output was not valid JSON: {cmd[0]}"
                self.diagnostics.add("error", "tool_runner", message, command=cmd, stdout=stdout[:2000], stderr=stderr[:2000])
                raise RuntimeError(message) from exc

        return completed.returncode, stdout, stderr


class Compiler:
    """Compiler abstraction with strict validation and resilient execution."""

    PRAGMA_RE = re.compile(r"pragma\s+solidity\s+([^;]+);")

    def __init__(self, diagnostics: Diagnostics, workspace_root: Path) -> None:
        self.diagnostics = diagnostics
        self.workspace_root = workspace_root
        self.compiler_path: str | None = None
        self.version: str | None = None

    def detect_pragma(self, source_files: list[Path]) -> str:
        versions: list[str] = []
        for source in source_files:
            try:
                content = source.read_text(encoding="utf-8", errors="replace")
            except OSError as exc:
                self.diagnostics.add("warning", "compiler", f"Unable to read source: {source}", path=str(source), error=str(exc))
                continue
            for match in self.PRAGMA_RE.finditer(content):
                versions.append(match.group(1).strip())

        if not versions:
            self.diagnostics.add("warning", "compiler", "No pragma found; defaulting to 0.8.20")
            return "0.8.20"

        candidates = []
        for value in versions:
            match = re.search(r"(\d+)\.(\d+)\.(\d+)", value)
            if match:
                candidates.append(".".join(match.groups()))

        if not candidates:
            self.diagnostics.add("warning", "compiler", f"Unparsed pragma found: {versions}")
            return "0.8.20"

        return sorted(candidates, key=lambda s: tuple(int(part) for part in s.split("."))) [-1]

    def ensure_compiler(self, version: str | None) -> str:
        validated = validate_solc_version(version) if version is not None else None
        candidate = validated or "0.8.20"
        solc = shutil.which("solc")
        if solc is None:
            raise RuntimeError("solc is required in the current environment for compiler validation")
        self.version = candidate
        self.compiler_path = solc
        self.diagnostics.add("info", "compiler", f"Using compiler binary {solc} for version {candidate}")
        return solc

    def compile(self, source_files: list[Path]) -> dict:
        if self.compiler_path is None:
            raise RuntimeError("Compiler was not initialized")

        arguments = [self.compiler_path, "--ast-json", "--base-path", str(self.workspace_root)]
        for source in source_files:
            arguments.append(str(source))

        runner = ToolRunner(self.diagnostics, sandbox=True)
        _, stdout, stderr = runner.run(arguments, timeout=300, cwd=self.workspace_root, expect_json=True, allow_empty=False)
        try:
            return json.loads(stdout)
        except json.JSONDecodeError as exc:
            message = "Compiler returned unreadable JSON AST"
            self.diagnostics.add("error", "compiler", message, stderr=stderr[:2000])
            raise RuntimeError(message) from exc
