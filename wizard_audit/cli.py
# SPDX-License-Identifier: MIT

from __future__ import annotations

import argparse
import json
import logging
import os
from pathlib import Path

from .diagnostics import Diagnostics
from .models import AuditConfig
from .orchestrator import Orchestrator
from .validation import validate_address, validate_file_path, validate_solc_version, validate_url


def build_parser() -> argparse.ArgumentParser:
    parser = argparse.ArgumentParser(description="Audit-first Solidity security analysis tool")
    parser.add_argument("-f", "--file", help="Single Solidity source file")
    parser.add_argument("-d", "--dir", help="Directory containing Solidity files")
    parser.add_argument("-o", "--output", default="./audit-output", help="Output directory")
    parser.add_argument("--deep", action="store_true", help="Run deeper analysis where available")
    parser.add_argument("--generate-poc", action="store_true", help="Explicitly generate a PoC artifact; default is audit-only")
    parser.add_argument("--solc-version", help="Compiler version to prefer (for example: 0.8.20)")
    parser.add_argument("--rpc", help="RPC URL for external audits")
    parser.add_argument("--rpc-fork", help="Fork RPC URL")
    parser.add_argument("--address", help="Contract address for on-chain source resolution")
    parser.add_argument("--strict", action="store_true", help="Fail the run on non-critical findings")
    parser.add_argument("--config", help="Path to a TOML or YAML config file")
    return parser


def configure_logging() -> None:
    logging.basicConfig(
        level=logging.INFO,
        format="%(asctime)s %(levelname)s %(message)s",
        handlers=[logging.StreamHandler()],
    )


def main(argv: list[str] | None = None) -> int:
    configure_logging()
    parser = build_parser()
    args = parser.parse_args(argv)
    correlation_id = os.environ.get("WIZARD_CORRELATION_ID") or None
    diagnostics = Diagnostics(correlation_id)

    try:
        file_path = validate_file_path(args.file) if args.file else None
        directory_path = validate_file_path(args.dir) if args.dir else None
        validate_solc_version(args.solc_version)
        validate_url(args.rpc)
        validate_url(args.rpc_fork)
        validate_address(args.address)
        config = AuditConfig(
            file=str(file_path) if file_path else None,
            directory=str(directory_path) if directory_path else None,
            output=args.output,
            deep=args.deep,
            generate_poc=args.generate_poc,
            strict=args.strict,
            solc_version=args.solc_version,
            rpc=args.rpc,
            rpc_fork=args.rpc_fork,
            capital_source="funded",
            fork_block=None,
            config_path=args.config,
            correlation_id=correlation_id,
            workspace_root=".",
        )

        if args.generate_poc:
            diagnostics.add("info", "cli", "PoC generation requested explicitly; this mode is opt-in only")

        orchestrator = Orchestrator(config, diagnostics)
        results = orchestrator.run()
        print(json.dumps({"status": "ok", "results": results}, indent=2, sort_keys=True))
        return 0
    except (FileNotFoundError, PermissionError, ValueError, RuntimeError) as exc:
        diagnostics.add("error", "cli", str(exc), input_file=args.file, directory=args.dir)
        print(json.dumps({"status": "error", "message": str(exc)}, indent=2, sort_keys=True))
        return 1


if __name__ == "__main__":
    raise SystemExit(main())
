from __future__ import annotations

from pathlib import Path

from .diagnostics import Diagnostics
from .models import AuditConfig


class Orchestrator:
    """Main orchestration object for the audit workflow."""

    def __init__(self, config: AuditConfig, diagnostics: Diagnostics | None = None) -> None:
        self.config = config
        self.diagnostics = diagnostics or Diagnostics(config.correlation_id)

    def run(self) -> list[dict[str, object]]:
        if self.config.file is None and self.config.directory is None:
            raise ValueError("Either a file or a directory must be provided")

        source_files = self._prepare_sources()
        if not source_files:
            raise FileNotFoundError("No Solidity source files were found")

        from .compiler import Compiler
        from .hunter import AuditHunter
        from .scorer import Scorer
        from .source_mapper import SourceMapper
        from .exporter import Exporter

        compiler = Compiler(self.diagnostics, Path(self.config.workspace_root).resolve())
        version = compiler.detect_pragma(source_files)
        compiler.ensure_compiler(version)
        ast = compiler.compile(source_files)

        source_map = SourceMapper({path.name: path for path in source_files})
        source_texts = {path.name: path.read_text(encoding="utf-8", errors="replace") for path in source_files}
        source_map.build(ast)

        hunter = AuditHunter(self.diagnostics)
        findings = hunter.scan(ast, source_texts)
        for finding in findings:
            score = Scorer.score(finding)
            finding.confidence = score.confidence
            finding.score = score.score
        exporter = Exporter(self.config, self.diagnostics)
        report_path = exporter.write_report(findings, evidence={"compiler_version": version, "source_files": [str(path) for path in source_files]})
        exporter.write_summary(findings)
        exporter.write_diagnostics()

        self.diagnostics.add("info", "orchestrator", "Audit completed successfully", report=str(report_path), findings=len(findings))
        return [{"id": item.id, "category": item.category, "confidence": item.confidence, "score": item.score} for item in findings]

    def _prepare_sources(self) -> list[Path]:
        selected: list[Path] = []
        if self.config.file:
            path = Path(self.config.file).expanduser().resolve()
            if path.is_file() and path.suffix.lower() == ".sol":
                selected.append(path)
        if self.config.directory:
            directory = Path(self.config.directory).expanduser().resolve()
            if directory.is_dir():
                for path in sorted(directory.rglob("*.sol")):
                    selected.append(path)
        return selected
